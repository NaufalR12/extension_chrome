{
  "manifest_version": 3,
  "name": "BERIBUG",
  "version": "1.0.0",
  "description": "Tracking & Reporting for Application Crash & Errors",
  "permissions": [
    "storage",
    "identity",
    "activeTab",
    "tabs",
    "desktopCapture",
    "scripting",
    "alarms",
    "offscreen",
    "debugger",
    "cookies",
    "webRequest",
    "webRequestExtraHeaders",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://api.monday.com/v2",
    "https://api.country.is/*"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "Open BERIBUG"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["js/injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
