{
  "manifest_version": 3,
  "name": "T.R.A.C.E",
  "version": "1.0.0",
  "description": "Tracking & Reporting for Application Crash & Errors",
  "permissions": [
    "storage",
    "identity",
    "activeTab",
    "tabs",
    "desktopCapture",
    "scripting",
    "alarms",
    "offscreen",
    "cookies",
    "webRequest",
    "webRequestExtraHeaders",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://www.googleapis.com/*",
    "https://api.monday.com/v2",
    "https://api.country.is/*"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "Open T.R.A.C.E"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["js/injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "oauth2": {
    "client_id": "1061102325924-e59pl3dmo0646r2sqoadqvlr184knf9g.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
